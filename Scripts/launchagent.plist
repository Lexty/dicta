<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template. `Scripts/render-agent.sh` substitutes the placeholders below, and `Scripts/install.sh`
  writes its output to ~/Library/LaunchAgents/dev.personal.dicta.plist. It is a template rather
  than a finished file because launchd resolves neither `~` nor `$HOME` in any of these keys. A test
  asserts that every placeholder this file contains is one the renderer actually replaces, and that
  what it renders passes `plutil -lint` with the option on and off.

  A USER agent, not a system daemon (D11): dicta needs this user's audio session, this user's TCC
  grant, this user's Application Support directory and this user's agterm. There is nothing for it
  to do in a context where none of those exist.

  It runs the binary INSIDE the signed bundle. That is the whole point of Task 8 — launching
  .build/release/Dicta directly would work and would have the microphone grant attributed to
  whatever terminal started it, which is the failure D11 describes.
-->
<plist version="1.0">
<dict>
    <!-- Same string as CFBundleIdentifier and as `Paths.bundleID`: one identity everywhere. It is
         also the label `launchctl bootout gui/$UID/…` takes. -->
    <key>Label</key>
    <string>dev.personal.dicta</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DICTA_APP__/Contents/MacOS/Dicta</string>
        <!-- The focused-fields line (D31). With the installer's flag it becomes that flag, and
             without it the line is removed: never an empty argument, which the daemon refuses. -->
        <string>__DICTA_FOCUSED_FIELDS__</string>
    </array>

    <!-- At login, and again whenever it dies: the chords are dead while the daemon is not running,
         and the user finds that out by pressing one and getting silence. launchd throttles restarts
         to one per ten seconds, so a daemon that cannot start loops slowly and says why in the log
         rather than spinning. A missing agtermctl is such a start only without focused fields;
         with them the daemon logs it and runs. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- The keypress budget is 150 ms (F4). The default process type lets launchd treat a resident
         background job as throttleable; Interactive says this one is on a human's critical path. -->
    <key>ProcessType</key>
    <string>Interactive</string>

    <!-- The daemon logs to stderr only (Scripts/run.sh reads it the same way). Absolute path,
         written by install.sh -- launchd does not expand ~ here. -->
    <key>StandardErrorPath</key>
    <string>__DICTA_LOG__</string>
</dict>
</plist>
